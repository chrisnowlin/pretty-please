{
  "embeddings": {
    "task": "retrieval.passage",
    "dimensions": 2048,
    "late_chunking": true,
    "return_multivector": true,
    "embedding_format": "float",
    "batch_size": 32,
    "max_tokens_per_batch": 8192
  },
  "ocr": {
    "batch_size": 32,
    "render_workers": 20,
    "analysis_workers": 2,
    "pre_render_batches": 4,
    "checkpoint_enabled": true,
    "resolution_mode": "base",
    "enable_grounding": true,
    "enable_compression": true,
    "use_vllm": false
  }
}